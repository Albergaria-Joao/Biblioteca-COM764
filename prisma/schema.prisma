// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL") // Ignora esse erro se tiver, o meu formatador do VS pelo menos tá no Prisma 7 (que não tem mais URL) e fica vermelho
}

model Usuario {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  nome           String
  email          String   @unique
  senha          String
  cpf            String   @unique // Preferi usar CPF porque o RG vai ser substituído 
  dataNascimento DateTime
  telefone       String
  status         String   @default("ATIVO")
  cargo          String   @default("USER")

  Endereco   Endereco @relation(fields: [enderecoId], references: [id]) // Coloco esse atributo do tipo Endereco pra criar a relação. O FK é o enderecoId
  enderecoId String   @unique @db.ObjectId

  reservas Reservas[] // Relação 1:N com Reservas (quem vai ter FK é a Reserva)
}

model Endereco {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  cep         String
  usuarios    Usuario? // Relacionamento inverso para acessar o usuário associado a essee endereço
}

model Acervo {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  isbn          String     @unique
  titulo        String
  autor         String
  editora       String
  edicao        String
  anoPublicacao Int
  descricao     String
  unidades      Int
  reservas      Reservas[]
}

model Reservas {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  // Tirei os atributos de livro daqui, podemos pegar pelo ID do acervo
  dataRes DateTime @default(now())
  valiRes DateTime

  Usuario   Usuario @relation(fields: [usuarioId], references: [id]) // Quem tem a FK é a reserva (1:N), então colocamos isso aqui em vez de no usuário!
  usuarioId String  @db.ObjectId

  acervo   Acervo @relation(fields: [acervoId], references: [id])
  acervoId String @db.ObjectId
}
