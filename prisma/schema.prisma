// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL") // Ignora esse erro se tiver, o meu formatador do VS pelo menos tá no Prisma 7 (que não tem mais URL) e fica vermelho
}

model Usuario {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  nome           String
  email          String    @unique
  senha          String
  cpf            String    @unique // Preferi usar CPF porque o RG vai ser substituído 
  dataNascimento DateTime
  telefone       String
  status         String    @default("ATIVO")
  Endereco       Endereco  @relation(fields: [enderecoId], references: [id]) // Coloco esse atributo do tipo Endereco pra criar a relação. O FK é o enderecoId
  enderecoId     String    @unique @db.ObjectId
  reservas       Reservas? @relation(fields: [reservasId], references: [id])
  reservasId     String?   @db.ObjectId
}

model Endereco {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  cep         String
  usuarios    Usuario[] // Relacionamento inverso para acessar o usuário associado a essee endereço
}

model Acervo {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  isbn          String     @unique
  titulo        String
  autor         String
  editora       String
  edicao        String
  anoPublicacao Int
  descricao     String
  unidades      Int
  reservas      Reservas[]
}

model Reservas {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  isbn     String    @unique
  titulo   String
  autor    String
  Datares  DateTime  @default(now())
  Valires  DateTime
  usuarios Usuario[]
  acervo   Acervo?   @relation(fields: [acervoId], references: [id])
  acervoId String?   @db.ObjectId
}
